{
  "expo": {
    "name": "Ozginbol",
    "slug": "ozginbol",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "uz.ozginbol.app"
    },
    "android": {
      "package": "uz.ozginbol.app",
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.ACTIVITY_RECOGNITION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Shtrix-kodni skanerlash va progress rasmlarini olish uchun kamera kerak.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Qadamlaringizni hisoblash uchun harakat ma'lumoti kerak."
        }
      ],
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Progress rasmlarini galereyadan tanlash uchun ruxsat kerak.",
          "cameraPermission": "Progress rasmlarini olish uchun kamera kerak."
        }
      ]
    ]
  }
}
